# Copy to .env and adjust. Never commit a real .env.
# The sidecar refuses to start without TWINFLOW_PRIMARY_URL.

# Central PostgreSQL (source of truth)
TWINFLOW_PRIMARY_URL=postgres://twinflow:twinflow-local@127.0.0.1:5432/cafe
POSTGRES_PASSWORD=twinflow-local

# Optional shared secret for /v1/* (leave empty only on a trusted local network)
TWINFLOW_API_TOKEN=

# Optional idempotent SQL applied on boot (used by the Render demo Blueprint)
# TWINFLOW_SEED_SQL=examples/init.sql

# Sidecar bind + local mirror file
TWINFLOW_LISTEN=0.0.0.0:8741
TWINFLOW_MIRROR_PATH=data/mirror.db
TWINFLOW_CONFIG=configs/twinflow.yaml
TWINFLOW_TLS_MODE=disable
TWINFLOW_LOG_LEVEL=info

# Regulator — keep these modest so a spike cannot open unbounded DB sessions
TWINFLOW_RATE_LIMIT_RPS=50
TWINFLOW_MAX_CONNS=8
TWINFLOW_WRITE_QUEUE_SIZE=512
TWINFLOW_SYNC_INTERVAL=1s
TWINFLOW_MAX_MIRROR_LAG=3s

# Comma-separated tables whose reads must skip the mirror
TWINFLOW_FRESH_TABLES=stock

# Demo site (server-side proxy; the browser never sees the token)
TWINFLOW_URL=http://127.0.0.1:8741
PORT=43123
