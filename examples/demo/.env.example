# Server-side only. The browser talks to Next.js /api/tf/* routes.
# On Vercel, set TWINFLOW_URL to the public Render sidecar origin
# (https://….onrender.com) — never commit a real token.
TWINFLOW_URL=http://127.0.0.1:8741
TWINFLOW_API_TOKEN=
# Optional public café URL for the offline-panel CTA (leave empty if /demo is it)
# NEXT_PUBLIC_HOSTED_DEMO_URL=
PORT=43123
NEXT_TELEMETRY_DISABLED=1
